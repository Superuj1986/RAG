# Required for Gemini answer generation
GOOGLE_API_KEY=

# Optional alias if your environment already uses this name
GEMINI_API_KEY=

# Required only when running LLM-judged evaluations
OPENAI_API_KEY=

# Models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini

# Local Hugging Face models
EMBED_MODEL=sentence-transformers/paraphrase-MiniLM-L3-v2
RERANK_MODEL=BAAI/bge-reranker-base
