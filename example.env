# Required for Gemini answer generation
GOOGLE_API_KEY=

# Optional alias if your environment already uses this name
GEMINI_API_KEY=

# Required only when running LLM-judged evaluations
OPENAI_API_KEY=

# Models
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini

# Local Hugging Face models
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# Retrieval
DIRECT_TOP_K=5
SENTENCE_WINDOW_TOP_K=6
SENTENCE_WINDOW_SIZE=3
AUTO_MERGING_TOP_K=12
RERANK_TOP_N=3

# Set false to skip the optional cross-encoder reranker
ENABLE_RERANKER=true

# Paths
DATA_DIR=data/documents
INDEX_DIR=data/indexes
EVAL_DATASET=eval/questions.json
